# --- Jira Cloud -------------------------------------------------------------
# Sitio de Jira y credenciales de una cuenta con permiso de lectura sobre CSE y SGCC.
# El token se genera en https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://construiblec.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# --- Servidor ---------------------------------------------------------------
PORT=3100
# Minutos que se reutiliza la última descarga antes de volver a consultar Jira.
CACHE_TTL_MINUTES=5

# --- Acceso -----------------------------------------------------------------
# Contraseña compartida del dashboard. Si se deja vacía, el dashboard queda abierto
# (solo para desarrollo local).
DASHBOARD_PASSWORD=
# Secreto para firmar las sesiones. Obligatorio si hay contraseña.
SESSION_SECRET=
# Horas de validez de una sesión.
SESSION_HOURS=12

# --- Desarrollo sin Jira ----------------------------------------------------
# Carpeta con issues.json, sprints.json, statuses.json y (opcional) changelogs.json.
# Si se define, el backend NO consulta Jira y sirve esos archivos.
JIRA_FIXTURE_DIR=
# Si se define, cada descarga real de Jira se guarda en esta carpeta con el mismo
# formato que JIRA_FIXTURE_DIR (útil para reproducir un problema sin red).
JIRA_DUMP_DIR=

# Ruta de la configuración editable (por defecto backend/dashboard.config.json).
DASHBOARD_CONFIG_PATH=

# Carpeta del frontend compilado que sirve este proceso (por defecto ../frontend/dist).
FRONTEND_DIST=
